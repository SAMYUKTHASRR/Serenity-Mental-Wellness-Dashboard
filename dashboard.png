<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard — Serenity</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,500;1,9..144,600&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.44.0/tabler-icons.min.css" />
  <link rel="stylesheet" href="style.css" />
</head>
<body>

  <canvas id="petalCanvas"></canvas>
  <div class="grain"></div>

  <!-- ── NAV ── -->
  <nav class="nav" id="siteNav">
    <a href="index.html" class="nav-logo"><span class="nav-mark">✦</span> Serenity</a>
    <button class="nav-toggle" id="navToggle" aria-label="Toggle menu"><span></span><span></span><span></span></button>
    <div class="nav-links" id="navLinks">
      <a href="index.html" data-nav>Home</a>
      <a href="about.html" data-nav>About</a>
      <a href="features.html" data-nav>Features</a>
      <a href="dashboard.html" data-nav>Dashboard</a>
      <a href="quotes.html" data-nav>Quotes</a>
    </div>
    <div class="nav-time" id="clockBadge">--:-- --</div>
  </nav>

  <!-- ── DASHBOARD ── -->
  <section class="dashboard-section" style="border-top:none;">
    <div class="section-tag center" data-reveal>Your Space</div>
    <h2 class="section-title center" data-reveal>Your Daily <em>Dashboard</em></h2>

    <!-- Mini stats -->
    <div class="dash-stat-row" data-reveal>
      <div class="dash-stat">
        <div class="dash-stat-val" id="stat-mood">—</div>
        <div class="dash-stat-label">Today's Mood</div>
      </div>
      <div class="dash-stat">
        <div class="dash-stat-val" id="stat-focus">0</div>
        <div class="dash-stat-label">Focus Sessions</div>
      </div>
      <div class="dash-stat">
        <div class="dash-stat-val" id="stat-tasks">0/0</div>
        <div class="dash-stat-label">Tasks Done</div>
      </div>
      <div class="dash-stat">
        <div class="dash-stat-val" id="stat-streak">0🔥</div>
        <div class="dash-stat-label">Day Streak</div>
      </div>
    </div>

    <div class="dash-grid">

      <!-- Mood tracker -->
      <div class="dash-card" data-reveal data-reveal-delay="0">
        <div class="dash-card-title"><i class="ti ti-mood-smile"></i>Mood Tracker</div>
        <div class="mood-row">
          <button class="mood-btn" onclick="logMood('😔','Low',this)">
            <span class="mood-emoji">😔</span>Low
          </button>
          <button class="mood-btn" onclick="logMood('😐','Okay',this)">
            <span class="mood-emoji">😐</span>Okay
          </button>
          <button class="mood-btn" onclick="logMood('🙂','Good',this)">
            <span class="mood-emoji">🙂</span>Good
          </button>
          <button class="mood-btn" onclick="logMood('😊','Great',this)">
            <span class="mood-emoji">😊</span>Great
          </button>
          <button class="mood-btn" onclick="logMood('🤩','Amazing',this)">
            <span class="mood-emoji">🤩</span>Amazing
          </button>
        </div>
        <div class="mood-history" id="moodHistory">
          <span class="mood-empty">No entries yet — tap a mood above</span>
        </div>
      </div>

      <!-- Focus timer -->
      <div class="dash-card" data-reveal data-reveal-delay="1">
        <div class="dash-card-title"><i class="ti ti-clock"></i>Focus Timer</div>
        <div class="focus-display">
          <div class="focus-ring-wrap">
            <svg class="focus-svg" viewBox="0 0 160 160">
              <circle class="focus-track" cx="80" cy="80" r="70"></circle>
              <circle class="focus-progress" id="focusProgress" cx="80" cy="80" r="70"></circle>
            </svg>
            <div class="focus-ring-center">
              <div class="focus-time" id="focusTime">25:00</div>
              <div class="focus-label" id="focusLabel">Pomodoro · Ready</div>
            </div>
          </div>
        </div>
        <div class="focus-btns">
          <button class="f-btn" onclick="setMode('short')">Break 5m</button>
          <button class="f-btn primary" id="focusStartBtn" onclick="toggleFocus()">Start</button>
          <button class="f-btn" onclick="setMode('long')">Focus 25m</button>
        </div>
        <div class="focus-rings" id="focusRings">
          <div class="ring"></div>
          <div class="ring"></div>
          <div class="ring"></div>
          <div class="ring"></div>
        </div>
        <div class="session-count" id="sessionCount">Sessions completed: 0</div>
      </div>

      <!-- Wellness insights -->
      <div class="dash-card" data-reveal data-reveal-delay="2">
        <div class="dash-card-title"><i class="ti ti-heart-rate-monitor"></i>Wellness Insights</div>
        <div class="insight-row">
          <div class="ins-icon green-bg"><i class="ti ti-droplet"></i></div>
          <div class="ins-info">
            <div class="ins-label">Hydration</div>
            <div class="ins-sub" id="hydration-sub">0 of 8 glasses</div>
          </div>
          <div class="ins-bar-wrap">
            <div class="ins-bar-track"><div class="ins-bar-fill hydration" id="hydration-bar" style="width:0%"></div></div>
            <div class="ins-val" id="hydration-val">0%</div>
          </div>
        </div>
        <div class="insight-row">
          <div class="ins-icon lv-bg"><i class="ti ti-moon"></i></div>
          <div class="ins-info">
            <div class="ins-label">Sleep</div>
            <div class="ins-sub" id="sleep-sub">Log hours below</div>
          </div>
          <div class="ins-bar-wrap">
            <div class="ins-bar-track"><div class="ins-bar-fill sleep" id="sleep-bar" style="width:0%"></div></div>
            <div class="ins-val" id="sleep-val">0h</div>
          </div>
        </div>
        <div class="insight-row last">
          <div class="ins-icon pink-bg"><i class="ti ti-run"></i></div>
          <div class="ins-info">
            <div class="ins-label">Movement</div>
            <div class="ins-sub" id="move-sub">0 min today</div>
          </div>
          <div class="ins-bar-wrap">
            <div class="ins-bar-track"><div class="ins-bar-fill move" id="move-bar" style="width:0%"></div></div>
            <div class="ins-val" id="move-val">0%</div>
          </div>
        </div>
        <div class="wellness-inputs">
          <div class="w-inp-group">
            <div class="w-inp-label">Water (glasses)</div>
            <input class="w-input" type="number" min="0" max="8" placeholder="0–8"
              oninput="updateWellness('hydration', this.value)">
          </div>
          <div class="w-inp-group">
            <div class="w-inp-label">Sleep (hours)</div>
            <input class="w-input" type="number" min="0" max="12" placeholder="0–12"
              oninput="updateWellness('sleep', this.value)">
          </div>
          <div class="w-inp-group">
            <div class="w-inp-label">Movement (min)</div>
            <input class="w-input" type="number" min="0" max="120" placeholder="0–120"
              oninput="updateWellness('move', this.value)">
          </div>
        </div>
      </div>

      <!-- Productivity -->
      <div class="dash-card" data-reveal data-reveal-delay="3">
        <div class="dash-card-title"><i class="ti ti-checkbox"></i>Productivity Balance</div>
        <div class="prod-grid" id="prodGrid"></div>
        <div class="prod-legend">
          <span class="prod-leg"><span class="prod-leg-sq none"></span>None</span>
          <span class="prod-leg"><span class="prod-leg-sq low"></span>Low</span>
          <span class="prod-leg"><span class="prod-leg-sq mid"></span>Mid</span>
          <span class="prod-leg"><span class="prod-leg-sq high"></span>High</span>
        </div>
        <div class="prod-task-row">
          <input class="prod-input" id="taskInput" placeholder="Add a task..."
            onkeydown="if(event.key==='Enter') addTask()">
          <button class="prod-add-btn" onclick="addTask()">+</button>
        </div>
        <div class="task-list" id="taskList"></div>
      </div>

    </div>
  </section>

  <!-- ── TOAST ── -->
  <div class="toast" id="toast"></div>

  <!-- ── FOOTER ── -->
  <footer class="footer">
    <div class="footer-logo">✦ Serenity</div>
    <div class="footer-sub">A personal mental wellness dashboard · Built with care</div>
    <div class="footer-links">
      <a href="https://github.com/SAMYUKTHASRR" target="_blank">GitHub</a>
      <a href="https://linkedin.com/in/samyuktha-sanil-b5b285291" target="_blank">LinkedIn</a>
    </div>
  </footer>

  <button class="scroll-top" id="scrollTop" aria-label="Back to top">↑</button>

  <script src="script.js"></script>
</body>
</html>
